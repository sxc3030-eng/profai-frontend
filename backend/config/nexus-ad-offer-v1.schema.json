{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus-ad-offer-v1.schema.json",
  "title": "Nexus advertising response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["offers"],
  "properties": {
    "offers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "cta_text", "cta_url"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "cta_text": {"type": "string", "minLength": 1, "maxLength": 120},
          "cta_url": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^https://"},
          "visual_url": {"type": ["string", "null"], "maxLength": 2000, "pattern": "^https://media\\.genia\\.social/"},
          "expires_at": {"type": ["string", "null"], "format": "date-time", "maxLength": 64}
        }
      }
    }
  }
}
